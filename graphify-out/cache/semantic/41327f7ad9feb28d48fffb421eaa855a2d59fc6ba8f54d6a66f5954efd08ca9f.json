{"nodes": [{"id": "blog_2026_03_08_spec_driven_development", "label": "Spec-Driven Development and Agentic Coding", "file_type": "document", "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 1", "source_url": null, "captured_at": "2026-03-08", "author": "Vishal Gandhi", "contributor": null}, {"id": "blog_sdd_spec_driven_development", "label": "Spec-Driven Development (SDD)", "file_type": "rationale", "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Addresses reliability debt and mental model loss from vibe coding. Puts specification (explicit external behavior: inputs/outputs, invariants, preconditions, postconditions, acceptance criteria) at the center rather than code. Idea: 'intent is the source of truth' rather than 'code is the source of truth'. Separates design from implementation and enables AI agents to stop guessing and start executing. Improves incident debuggability, onboarding, and spec serves as reviewable contract."}, {"id": "blog_sdd_vibe_coding", "label": "Vibe Coding", "file_type": "concept", "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "blog_sdd_context_engineering", "label": "Context Engineering for AI Agents", "file_type": "rationale", "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 163", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately curating what information AI agents have access to during long-horizon tasks. A well-written spec.md IS context engineering. Windsurfrules and AGENTS.md encode persistent project context. Kiro steering files support inclusion modes for granular agent context control."}, {"id": "blog_sdd_github_spec_kit", "label": "GitHub Spec Kit", "file_type": "concept", "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 69", "source_url": "https://github.com/github/spec-kit", "captured_at": null, "author": null, "contributor": null}, {"id": "blog_sdd_kiro_ide", "label": "Kiro (Amazon Agentic IDE)", "file_type": "concept", "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 203", "source_url": "https://kiro.dev", "captured_at": null, "author": null, "contributor": null}, {"id": "blog_sdd_windsurf_cascade", "label": "Windsurf Cascade AI Agent", "file_type": "concept", "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "blog_sdd_claude_code", "label": "Claude Code (Anthropic AI Coding Agent)", "file_type": "concept", "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 35", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "blog_2026_03_08_spec_driven_development", "target": "blog_authors_vishal_gandhi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 5", "weight": 1.0}, {"source": "blog_2026_03_08_spec_driven_development", "target": "blog_sdd_spec_driven_development", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 19", "weight": 1.0}, {"source": "blog_2026_03_08_spec_driven_development", "target": "blog_sdd_vibe_coding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "blog/2026-03-08-spec-driven-development.md", "source_location": "line 13", "weight": 1.0}, {"source": "blog_sdd_spec_driven_development", "target": "blog_sdd_vibe_coding", "relation": "concep