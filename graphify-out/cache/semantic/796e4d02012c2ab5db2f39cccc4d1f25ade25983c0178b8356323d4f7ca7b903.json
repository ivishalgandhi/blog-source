{"nodes": [{"id": "sdd_index", "label": "Spec-Driven Development Index", "file_type": "document", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": "line 1-75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sdd_concept", "label": "Spec-Driven Development (SDD)", "file_type": "concept", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": "line 9-24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sdd_workflow", "label": "SDD Workflow: spec \u2192 plan \u2192 tasks \u2192 code", "file_type": "rationale", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": "line 48-68", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sdd_speckit_tool", "label": "spec-kit (GitHub CLI Tool for SDD)", "file_type": "concept", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": "line 72-74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sdd_index", "label": "Spec-Driven Development (What is SDD?)", "file_type": "document", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sdd_concept", "label": "Spec-Driven Development", "file_type": "concept", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": "line 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDD inverts the traditional relationship between specs and code: the spec is the source of truth and code is generated from it. Three trends make this practical now: AI capability threshold reached (LLMs reliably translate natural-language specs to working code), exponential software complexity, and relentless pace of change. SDD makes requirement changes a systematic regeneration rather than manual rewrite."}, {"id": "sdd_spec_first", "label": "Spec-First Level", "file_type": "concept", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": "line 42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low commitment entry point: write a spec before each task, may be discarded after. Recommended starting point for most teams before graduating to Spec-Anchored."}, {"id": "sdd_spec_anchored", "label": "Spec-Anchored Level", "file_type": "concept", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": "line 43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Medium commitment: spec lives alongside code forever and evolves with the feature. Requires team alignment."}, {"id": "sdd_spec_as_source", "label": "Spec-as-Source Level", "file_type": "concept", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": "line 44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High commitment: spec is the primary artifact and code is generated output. Requires strong tooling."}, {"id": "sdd_workflow", "label": "SDD Workflow (Idea \u2192 spec.md \u2192 plan.md \u2192 tasks.md \u2192 Code)", "file_type": "concept", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": "line 49-66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each stage produces a human-reviewed markdown artifact before the next stage begins. Human is pilot, AI is co-pilot doing mechanical translation."}, {"id": "sdd_martin_fowler_article", "label": "Martin Fowler: Understanding SDD \u2014 Kiro, spec-kit, and Tessl", "file_type": "document", "source_file": "docs/genai/spec-driven-development/index.md", "source_location": "line 72", "source_url": "https://martinfowler.com/articles/exploring-gen-ai/sdd-3-tools.ht