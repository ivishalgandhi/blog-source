{"nodes": [{"id": "slides_sdd_tradeoffs", "label": "SDD Tradeoffs and When to Use", "file_type": "rationale", "source_file": "docs/demos/health-check-scanner/.demo/slides/15-tradeoffs.md", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDD is not a silver bullet. Per Martin Fowler: 'Sledgehammer for a nut' for small bugs, 'False sense of control' since AI doesn't always follow instructions, 'Reviewing markdown harder than code'. Use for 3-8 point features and greenfield. Skip for small bugs and emergency hotfixes. Start Level 1, earn Level 2."}, {"id": "slides_martin_fowler_sdd", "label": "Martin Fowler SDD Research", "file_type": "concept", "source_file": "docs/demos/health-check-scanner/.demo/slides/15-tradeoffs.md", "source_location": "line 7", "source_url": "martinfowler.com/articles/exploring-gen-ai/sdd-3-tools.html", "captured_at": null, "author": "Martin Fowler", "contributor": null}], "edges": [{"source": "slides_sdd_tradeoffs", "target": "slides_martin_fowler_sdd", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/demos/health-check-scanner/.demo/slides/15-tradeoffs.md", "source_location": "line 7", "weight": 1.0}, {"source": "slides_sdd_tradeoffs", "target": "slides_spec_driven_development", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/demos/health-check-scanner/.demo/slides/15-tradeoffs.md", "source_location": null, "weight": 1.0}], "hyperedges": []}