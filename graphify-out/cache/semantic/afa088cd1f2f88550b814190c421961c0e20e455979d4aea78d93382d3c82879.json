{"nodes": [{"id": "presentations_sdd_presentation", "label": "Spec-Driven Development Presentation (Marp)", "file_type": "document", "source_file": "docs/presentations/sdd-presentation.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Vishal Gandhi", "contributor": null}, {"id": "concept_spec_driven_development", "label": "Spec-Driven Development (SDD)", "file_type": "concept", "source_file": "docs/presentations/sdd-presentation.md", "source_location": "line 154", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDD inverts traditional development: specs serve as the source of truth instead of code. Three levels exist: Spec-First (disposable), Spec-Anchored (lives alongside code), and Spec-as-Source (code is generated output). Motivation: AI can now reliably translate natural language specs to code, complexity is exponential, and pivots are normal \u2014 regenerating from spec beats manual rewrites."}, {"id": "concept_spec_kit", "label": "spec-kit CLI Toolkit", "file_type": "concept", "source_file": "docs/presentations/sdd-presentation.md", "source_location": "line 329", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub's open-source SDD toolkit. Targets Level 2 (Spec-Anchored). All artifacts live in repo under .specify/ folder, versioned with code. Works with Windsurf, Cursor, Claude, GitHub Copilot."}, {"id": "concept_sdd_constitution", "label": "SDD Constitution (Immutable AI Principles)", "file_type": "rationale", "source_file": "docs/presentations/sdd-presentation.md", "source_location": "line 348", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The constitution is a memory/constitution.md file defining immutable principles applied to every AI interaction. Nine articles cover: Library-First, CLI Interface, Test-First, Integration tests, Research-driven, Versioning, Simplicity Gate, Anti-Abstraction, Integration-First. Equivalent to Windsurf .windsurfrules."}, {"id": "concept_vibe_coding", "label": "Vibe Coding (Code-First AI Development)", "file_type": "concept", "source_file": "docs/presentations/sdd-presentation.md", "source_location": "line 283", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contrasted with SDD: unstructured prompts lead to AI guessing and architectural drift. Failure mode is silent drift vs SDD's visible test failures."}, {"id": "concept_windsurf_cascade", "label": "Windsurf Cascade AI Agent", "file_type": "concept", "source_file": "docs/presentations/sdd-presentation.md", "source_location": "line 538", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "presentations_sdd_presentation", "target": "concept_spec_driven_development", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/presentations/sdd-presentation.md", "source_location": "line 154", "weight": 1.0}, {"source": "presentations_sdd_presentation", "target": "concept_spec_kit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/presentations/sdd-presentation.md", "source_location": "line 329", "weight": 1.0}, {"source": "presentations_sdd_presentation", "target": "concept_sdd_constitution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/presentations/sdd-presentation.md", "source_location": "line 348", "weight": 1.0}, {"source": "presentations_sdd_presentation", "target": "concept_vibe_coding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/presentations/sdd-presentation.md", "source_location": "line 283", "weight": 1.0}, {"source": "presentations_sdd_presentation", "target": "concept_windsurf_cascade", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source