# LAB-13-A Environment Overrides
# Copy to .env and customize as needed.

# Docker Compose project name
COMPOSE_PROJECT_NAME=lab-13-a

# Spilo image tag (default: ghcr.io/zalando/spilo-16:3.2-p1)
# SPILO_IMAGE=ghcr.io/zalando/spilo-16:3.2-p1

# etcd image tag (default: quay.io/coreos/etcd:v3.5.13)
# ETCD_IMAGE=quay.io/coreos/etcd:v3.5.13

# PostgreSQL superuser password (default: postgres-pass)
# POSTGRES_PASSWORD=postgres-pass

# Replication user password (default: replicator-pass)
# REPLICATOR_PASSWORD=replicator-pass
