      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(patroni_master{cluster=~\"$cluster\",namespace=~\"$namespace\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Leaders",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Leader Status",
      "type": "stat"
    },
