                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "leader": {
                        "color": "green",
                        "index": 0,
                        "text": "leader"
                      },
                      "replica": {
                        "color": "blue",
                        "index": 1,
                        "text": "replica"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
