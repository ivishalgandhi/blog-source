                  {
                    "options": {
                      "running": {
                        "color": "green",
                        "index": 0,
                        "text": "running"
                      },
                      "stopped": {
                        "color": "red",
                        "index": 1,
                        "text": "stopped"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
