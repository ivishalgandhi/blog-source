---
# /etc/patroni/patroni.yml
# Lab-B-A: Watchdog and Lease Pathology
# Source of truth: Appendix B — Patroni Internals Deep-Dive

scope: lab-b-a
namespace: /patroni/
name: {{ inventory_hostname }}

restapi:
  listen: {{ ansible_default_ipv4.address | default(ansible_host) }}:8008
  connect_address: {{ ansible_default_ipv4.address | default(ansible_host) }}:8008

etcd3:
  hosts:
{% for host in groups['etcd'] %}
    - {{ hostvars[host]['ansible_host'] | default(host) }}:2379
{% endfor %}

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_log_hints: on
        max_connections: 100
        max_locks_per_transaction: 64
        max_worker_processes: 8
        max_prepared_transactions: 0
        wal_level: replica
        wal_keep_size: 500MB
        max_wal_senders: 10
        max_replication_slots: 10
        hot_standby: "on"
  initdb:
    - encoding: UTF8
    - data-checksums
  pg_hba:
    - host replication replicator 127.0.0.1/32 scram-sha-256
{% for host in groups['patroni'] %}
    - host replication replicator {{ hostvars[host]['ansible_host'] | default(host) }}/32 scram-sha-256
{% endfor %}
    - host all all 0.0.0.0/0 scram-sha-256
  users:
    admin:
      password: admin
      options:
        - createrole
        - createdb

postgresql:
  listen: {{ ansible_default_ipv4.address | default(ansible_host) }}:5432,127.0.0.1:5432
  connect_address: {{ ansible_default_ipv4.address | default(ansible_host) }}:5432
  data_dir: {{ '/var/lib/postgresql/18/main' if ansible_os_family == 'Debian' else '/var/lib/pgsql/18/data' }}
  bin_dir: {{ '/usr/lib/postgresql/18/bin' if ansible_os_family == 'Debian' else '/usr/pgsql-18/bin' }}
  pgpass: /tmp/pgpass
  authentication:
    replication:
      username: replicator
      password: repass
    superuser:
      username: postgres
      password: postgres
    rewind:
      username: rewind_user
      password: rewind_pass
  parameters:
    unix_socket_directories: /var/run/postgresql

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false

watchdog:
  mode: required
  device: /dev/watchdog
  safety_margin: 5
